# Configuration Django pour production
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,yourdomain.com
PORT=8000

# Configuration Sentry (optionnel)
# Remplacez par votre vraie DSN Sentry
SENTRY_DSN=https://your-dsn-here@sentry.io/your-project-id

# Niveau pour créer des événements Sentry (WARNING, ERROR, CRITICAL)
# WARNING pour capturer aussi les 404
SENTRY_EVENT_LEVEL=WARNING

# Taux d'échantillonnage des traces (0.0 à 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.05

# Environnement (development, staging, production)
SENTRY_ENVIRONMENT=production

# Version de l'application
SENTRY_RELEASE=1.0.0