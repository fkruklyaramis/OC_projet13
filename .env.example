# Configuration Django pour développement local
# Générez une clé secrète avec: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-local-development-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
PORT=8000

# Configuration Sentry (optionnel - commenté pour le développement local)
# Décommentez et remplacez par votre vraie DSN Sentry pour la production
# SENTRY_DSN=https://your-dsn-here@sentry.io/your-project-id

# Niveau pour créer des événements Sentry (WARNING, ERROR, CRITICAL)
# WARNING pour capturer aussi les 404
SENTRY_EVENT_LEVEL=WARNING

# Taux d'échantillonnage des traces (0.0 à 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.05

# Environnement (development, staging, production)
SENTRY_ENVIRONMENT=development

# Version de l'application
SENTRY_RELEASE=1.0.0